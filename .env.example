# CardputerZero 网页控台与无线投屏测试服务配置文件 (.env)

# [网络与安全]
UI_LANG=zh                   # 界面显示语言：zh（中文）| en（英文）
LISTEN_HOST=0.0.0.0          # Web 控台与推送 API 监听地址（0.0.0.0 允许局域网访问）
LISTEN_PORT=8787             # Web 控台与推送 API 监听端口（1-65535）
CAST_TOKEN=                  # 可选推送鉴权口令（对应请求头 X-Cast-Token，留空不启用）
CAST_TIMEOUT_SEC=0           # 无新画面自动回退待机页秒数（0 表示常驻保留当前画面便于观察）

# [色彩与画面适配]
TARGET_FPS=0                 # 推流帧率控制：0 表示不限速全速显示，1-120 表示固定目标帧率上限（视频播放/游戏推流）
COLOR_MODE=rgb565            # 色彩渲染模式：rgb565 | rgb565_dither | gray | mono_floyd | mono_threshold
FIT_MODE=contain             # 缩放策略：contain（等比留边）| cover（等比裁切铺满）| stretch（拉伸铺满）
ROTATE=0                     # 顺时针旋转角度：0 | 90 | 180 | 270
BG_COLOR=#000000             # contain 留边背景色（#RRGGBB）
BRIGHTNESS=100               # 亮度百分比（20-200，100 为原始亮度）
CONTRAST=100                 # 对比度百分比（20-200，100 为原始对比度）
SATURATION=100               # 饱和度百分比（0-200，100 为原始饱和度）
THRESHOLD=128                # mono_threshold 硬二值化阈值（0-255）
INVERT=false                 # 是否反相画面颜色（true / false）
SHOW_OVERLAY=false           # 是否在设备屏幕右上角叠加模式与帧率角标（true / false）
